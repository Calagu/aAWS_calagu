# Plantilla: copiar a /etc/biblioteca/biblioteca.env (chmod 600) y poner la contrasena real.
# NO subir al repositorio el fichero relleno.
JAVA_OPTS=-Xms128m -Xmx384m
BIBLIOTECA_DB_USER=biblioteca_app
BIBLIOTECA_DB_PASSWORD=<contrasena de biblioteca_app>
BIBLIOTECA_ALUMNO=calagu
# Variante 1 (lista 5 mod 4)
BIBLIOTECA_PRESTAMO_MAXIMO=3
BIBLIOTECA_PRESTAMO_DIAS=14
